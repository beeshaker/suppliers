<odoo>
    <record id="view_supplier_category_list" model="ir.ui.view">
        <field name="name">supplier.category.list</field>
        <field name="model">supplier.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="complete_name" string="Category"/>
                <field name="supplier_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_supplier_category_form" model="ir.ui.view">
        <field name="name">supplier.category.form</field>
        <field name="model">supplier.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_suppliers" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="supplier_count" widget="statinfo" string="Suppliers"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="parent_id" options="{'no_create': True}"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Suppliers" name="suppliers">
                            <field name="category_line_ids">
                                <list editable="bottom">
                                    <field name="supplier_id" options="{'no_create': True}"/>
                                    <field name="is_preferred"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_supplier_category_search" model="ir.ui.view">
        <field name="name">supplier.category.search</field>
        <field name="model">supplier.category</field>
        <field name="arch" type="xml">
            <search string="Categories">
                <field name="complete_name" string="Category"/>
                <field name="parent_id"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
                <group>
                    <filter name="group_by_parent" string="Parent Category" context="{'group_by':'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_supplier_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">supplier.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_supplier_category_search"/>
    </record>
</odoo>
